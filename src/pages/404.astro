---
import BaseLayout from '../layouts/BaseLayout.astro';
import { internalUrl } from '../utils/url';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>This page has wandered off.</h1>
    <p>It may have moved, or it may never have existed. The <a href={internalUrl('/writing/')}>writing archive</a> is a good place to start again.</p>
  </section>
</BaseLayout>
