---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getReadingTime } from '../../utils/reading-time';
import { getAdjacentWriting, getPublishedWriting } from '../../utils/writing';
import { internalUrl } from '../../utils/url';

export async function getStaticPaths() {
  const entries = await getPublishedWriting();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, entries } }));
}

const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const readingTime = getReadingTime(entry.body);
const { newer, older } = getAdjacentWriting(entries, entry.id);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  published={entry.data.published}
  updated={entry.data.updated}
  category={entry.data.category}
  tags={entry.data.tags}
  {readingTime}
>
  <Content />
  <nav slot="after" class="article-pagination" aria-label="More writing">
    {newer ? <a href={internalUrl(`/writing/${newer.id}/`)} rel="prev"><span>Newer</span>{newer.data.title}</a> : <span />}
    {older ? <a class="article-pagination__next" href={internalUrl(`/writing/${older.id}/`)} rel="next"><span>Older</span>{older.data.title}</a> : <span />}
  </nav>
</ArticleLayout>
