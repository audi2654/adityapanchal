---
import ArticleMeta from '../components/ArticleMeta.astro';
import TagList from '../components/TagList.astro';
import BaseLayout from './BaseLayout.astro';
import { internalUrl } from '../utils/url';

interface Props {
  title: string;
  description: string;
  published: Date;
  updated?: Date;
  category: string;
  tags: string[];
  readingTime: number;
}

const { title, description, published, updated, category, tags, readingTime } = Astro.props;
---

<BaseLayout {title} {description} type="article" publishedTime={published} modifiedTime={updated}>
  <article class="article">
    <header class="article-header">
      <p class="eyebrow"><a href={internalUrl(`/categories/${category.toLowerCase().replaceAll(' ', '-')}/`)}>{category}</a></p>
      <h1>{title}</h1>
      <p class="article-dek">{description}</p>
      <ArticleMeta published={published} updated={updated} readingTime={readingTime} />
      <TagList {tags} />
    </header>
    <div class="prose">
      <slot />
    </div>
    <slot name="after" />
  </article>
</BaseLayout>
