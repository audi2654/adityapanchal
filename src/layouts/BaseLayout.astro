---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SiteHead from '../components/SiteHead.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: URL;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /* Unlisted pages: no crawling, no sitemap entry, no link from the site. */
  noindex?: boolean;
}

const { title, description, image, type, publishedTime, modifiedTime, noindex } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead {title} {description} {canonical} {image} {type} {publishedTime} {modifiedTime} {noindex} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content" class="page-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
