---
import { site } from '../config';
import { internalUrl } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  canonical?: URL;
  image?: URL;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description = site.description,
  canonical,
  image,
  type = 'website',
  publishedTime,
  modifiedTime
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.description}`;
const socialImage = image ?? new URL(internalUrl('/og.svg'), Astro.site ?? site.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#fdfcf9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#171716" media="(prefers-color-scheme: dark)" />
<meta name="description" content={description} />
<meta name="author" content={site.author} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonical?.toString()} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} — RSS`} href={internalUrl('/rss.xml')} />
<link rel="sitemap" href={internalUrl('/sitemap-index.xml')} />
<title>{pageTitle}</title>

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical?.toString()} />
<meta property="og:image" content={socialImage.toString()} />
<meta property="og:image:alt" content={`${site.name} — ${description}`} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage.toString()} />

{/*
  Applies a saved theme choice before the first paint so the page never flashes
  the wrong palette. With no saved choice, or with JavaScript unavailable, the
  `prefers-color-scheme` rules in global.css decide. Must stay inline.
*/}
<script is:inline>
  // The `js` class reveals the theme toggle, which is useless without scripting.
  document.documentElement.classList.add('js');
  try {
    const saved = localStorage.getItem('theme');
    if (saved === 'light' || saved === 'dark') {
      document.documentElement.dataset.theme = saved;
    }
  } catch {
    /* Storage can be blocked; the system preference still applies. */
  }
</script>
