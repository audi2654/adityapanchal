---
import { site } from '../config';
import { internalUrl } from '../utils/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>© {year} {site.name}. Built slowly, made to last.</p>
    <nav aria-label="Footer navigation">
      <ul>
        <li><a href={internalUrl('/uses/')}>Uses</a></li>
        <li><a href={internalUrl('/rss.xml')}>RSS</a></li>
        <li><a href={internalUrl('/sitemap-index.xml')}>Sitemap</a></li>
        <li><a href={site.github} rel="me external">GitHub</a></li>
      </ul>
    </nav>
  </div>
</footer>
