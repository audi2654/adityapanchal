---
import { navigation, site } from '../config';
import { internalUrl } from '../utils/url';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = basePath && Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length) || '/'
  : Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === href : pathname.startsWith(href);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-name" href={internalUrl('/')} aria-label={`${site.name}, home`}>{site.name}</a>
    <nav aria-label="Primary navigation">
      <ul class="site-nav">
        {navigation.map((item) => (
          <li>
            <a href={internalUrl(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
